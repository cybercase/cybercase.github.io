{
  "name": "nextblog",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "tsx scripts/build-feed.ts",
    "lint": "eslint .",
    "prepare": "husky install",
    "deploy": "npm run build && gh-pages -d out --dotfiles"
  },
  "dependencies": {
    "classnames": "^2.3.1",
    "feed": "^4.2.2",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.47",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^4.3.1",
    "rehype-highlight": "^5.0.2",
    "rehype-katex": "^6.0.2",
    "rehype-stringify": "^9.0.3",
    "remark-gfm": "^3.0.1",
    "remark-math": "^5.1.1",
    "remark-parse": "^10.0.1",
    "remark-rehype": "^10.1.0",
    "remark-smartypants": "^2.0.0",
    "unified": "^10.1.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "devDependencies": {
    "@types/node": "17.0.30",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "gh-pages": "^3.2.3",
    "husky": "^7.0.4",
    "lint-staged": "^12.4.1",
    "prettier": "^2.6.2",
    "sass": "^1.51.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": "eslint --cache",
    "*.{js,mjs,ts,tsx,css,scss,json}": "prettier --check"
  }
}
